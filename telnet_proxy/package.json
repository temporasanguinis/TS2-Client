{
  "name": "ts2-telnet-proxy",
  "version": "0.5.0",
  "scripts": {
    "start": "node tools/copyConfig.mjs && set DEBUG=* && node dist/telnet_proxy/src/app.js -c ./dist/telnet_proxy/bundle/config.json",
    "build": "node tools/genSecrets.mjs && tsc -p tsconfig.json && node tools/copyConfig.mjs",
    "postinstall": "node tools/postinstall.mjs",
    "webpack": "webpack --mode production",
    "webpack-start": "webpack --mode production && node ./dist/telnet_proxy/bundle/telnet_proxy.js"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/yargs": "^13.0.12",
    "@types/ws": "^8.18.1",
    "axios": "^1.19.0",
    "bufferutil": "^4.1.0",
    "express": "^5.2.1",
    "fs-extra": "^11.3.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2",
    "utf-8-validate": "^6.0.6",
    "yargs": "^13.3.2"
  },
  "devDependencies": {
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-node-externals": "^3.0.0"
  },
   "overrides": {
    "fast-uri": "^4.1.2"
  }
}
