{
    "compilerOptions": {
        "strict": true,
        "rootDir": "..",
        "outDir": "./dist",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "noImplicitAny": true,
        "strictNullChecks": false,
        "noImplicitReturns": true,
        "moduleResolution":"bundler",
        "target": "es2021",
        "module": "esnext",
    },
    "lib": [
        "ES2021"
    ],
    "include": [
        "./src/*"
    ]
}
